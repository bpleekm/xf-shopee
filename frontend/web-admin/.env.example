# Web Admin Environment Variables
# Copy this file to .env and adjust values as needed

# Base path for deployment
# Development: ./
# Production: /xfbh/admin/
VITE_BASE_PATH=/xfbh/admin/

# API Base URL
# Development: http://localhost:3000/api
# Production: /xfbh/api
VITE_API_BASE_URL=/xfbh/api

# Application Title
VITE_APP_TITLE=XF Shopee Admin

# Enable/disable debug mode
VITE_DEBUG=false

# Enable source maps in production
VITE_SOURCE_MAP=false

# Default language
VITE_DEFAULT_LANG=zh-CN

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=false

# Admin specific settings
VITE_ADMIN_THEME=light
VITE_PAGE_SIZE=20
VITE_ENABLE_AUDIT_LOG=true