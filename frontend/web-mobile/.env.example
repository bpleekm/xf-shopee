# Mobile H5 Frontend Environment Variables
# Copy this file to .env and adjust values as needed

# Base path for deployment
# Development: ./
# Production: /xfbh/mobile/
VITE_BASE_PATH=/xfbh/mobile/

# API Base URL
# Development: http://localhost:3000/api
# Production: /xfbh/api
VITE_API_BASE_URL=/xfbh/api

# Application Title
VITE_APP_TITLE=XF Shopee Mobile

# Enable/disable debug mode
VITE_DEBUG=false

# Enable source maps in production
VITE_SOURCE_MAP=false

# Default language
VITE_DEFAULT_LANG=zh-CN

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=false

# Mobile-specific settings
VITE_ENABLE_TOUCH_GESTURES=true
VITE_ENABLE_OFFLINE_CACHE=false
VITE_MOBILE_VIEWPORT_WIDTH=375