{
  "name": "xf-shopee-backend",
  "version": "1.0.0",
  "description": "Backend service for XF Shopee ERP system",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --config tests/jest.config.js",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:e2e": "jest --config tests/jest.config.js --testPathPattern=e2e",
    "db:migrate": "node database/migrate.js migrate",
    "db:rollback": "node database/migrate.js rollback",
    "db:status": "node database/migrate.js status",
    "db:fresh": "node database/migrate.js fresh"
  },
  "keywords": [
    "erp",
    "backend",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@faker-js/faker": "^8.4.0",
    "jest-junit": "^16.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
